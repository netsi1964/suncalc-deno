diff --git a/electron/main.cjs b/electron/main.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..6d93021c660da90f5da3f79a7abbd14db69e3b69
--- /dev/null
+++ b/electron/main.cjs
@@ -0,0 +1,110 @@
+const { app, BrowserWindow, dialog } = require('electron');
+const { spawn } = require('child_process');
+const path = require('path');
+
+const SERVER_URL = 'http://127.0.0.1:8000';
+const SERVER_START_TIMEOUT_MS = 15000;
+
+let denoProcess;
+
+function startDenoServer() {
+  const projectRoot = path.resolve(__dirname, '..');
+
+  denoProcess = spawn(
+    'deno',
+    ['run', '--allow-net', '--allow-read', 'main.ts'],
+    {
+      cwd: projectRoot,
+      stdio: 'inherit',
+      shell: process.platform === 'win32',
+    },
+  );
+
+  denoProcess.on('error', async (error) => {
+    await dialog.showErrorBox(
+      'Could not start Deno server',
+      `Electron failed to start the Deno server.\n\n${error.message}\n\nMake sure Deno is installed and available on PATH.`,
+    );
+    app.quit();
+  });
+
+  denoProcess.on('exit', (code) => {
+    if (!app.isQuitting && code !== 0) {
+      dialog.showErrorBox(
+        'Deno server stopped',
+        `The Deno server exited unexpectedly with code ${code}.`,
+      );
+      app.quit();
+    }
+  });
+}
+
+async function waitForServer(url, timeoutMs) {
+  const startedAt = Date.now();
+
+  while (Date.now() - startedAt < timeoutMs) {
+    try {
+      const response = await fetch(url, { method: 'GET' });
+      if (response.ok) {
+        return;
+      }
+    } catch (_error) {
+      // Retry until timeout.
+    }
+
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+
+  throw new Error(`Timed out waiting for ${url}`);
+}
+
+async function createWindow() {
+  const mainWindow = new BrowserWindow({
+    width: 1280,
+    height: 900,
+    minWidth: 900,
+    minHeight: 700,
+    autoHideMenuBar: true,
+    webPreferences: {
+      contextIsolation: true,
+      nodeIntegration: false,
+    },
+  });
+
+  await mainWindow.loadURL(SERVER_URL);
+}
+
+app.on('window-all-closed', () => {
+  if (process.platform !== 'darwin') {
+    app.quit();
+  }
+});
+
+app.on('before-quit', () => {
+  app.isQuitting = true;
+
+  if (denoProcess && !denoProcess.killed) {
+    denoProcess.kill();
+  }
+});
+
+app.whenReady().then(async () => {
+  startDenoServer();
+
+  try {
+    await waitForServer(SERVER_URL, SERVER_START_TIMEOUT_MS);
+    await createWindow();
+  } catch (error) {
+    dialog.showErrorBox(
+      'Server did not start',
+      `Could not reach ${SERVER_URL} within ${SERVER_START_TIMEOUT_MS / 1000} seconds.\n\n${error.message}`,
+    );
+    app.quit();
+  }
+
+  app.on('activate', async () => {
+    if (BrowserWindow.getAllWindows().length === 0) {
+      await createWindow();
+    }
+  });
+});
